# ---------------------------------------------------------------------------
# Supabase (v1: auth + hosted). Put real values in .env.local (gitignored) and
# mirror them in Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API. The NEXT_PUBLIC_* values are
# safe to expose to the browser; SUPABASE_SECRET_KEY must stay server-only.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (client) key — sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (server-only) key — sb_secret_...  Bypasses RLS; never expose.
SUPABASE_SECRET_KEY=

# JWKS URL for verifying Supabase-signed JWTs, e.g. <url>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Brewfather credentials — LOCAL DEV SCRIPTS ONLY (not required for the app).
#
# The app never reads these: every signed-in user connects their own key in
# Settings, where it is verified against Brewfather and stored encrypted in
# Supabase Vault. Only the offline dev spike (`npm run spike`,
# scripts/match-spike.ts) opts into these env vars.
#
# Generate a key in Brewfather: Settings -> API (requires Brewfather Premium),
# read access to Recipes + Inventory. The User ID is the short token shown next
# to the key — NOT your account email. Never commit your real .env.
# ---------------------------------------------------------------------------

# Dev-scripts-only Brewfather user id.
BF_USER_ID=

# Dev-scripts-only Brewfather API key (secret).
BF_API_KEY=
